{
    "name": "eyika/atom-octane",
    "description": "Octane-style persistent worker for the Atom framework — boot the application once, serve many requests, reset per-request state in between.",
    "type": "library",
    "keywords": ["atom", "octane", "worker", "performance"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "eyika/atom-framework": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "ext-pcntl": "Multi-worker process pool + graceful reload for the native server",
        "ext-swoole": "Run the Swoole runtime: octane:serve --server=swoole",
        "spiral/roadrunner-http": "Run the RoadRunner runtime: octane:serve --server=roadrunner",
        "nyholm/psr7": "PSR-17 factory required by the RoadRunner runtime"
    },
    "autoload": {
        "psr-4": {
            "Eyika\\Atom\\Octane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eyika\\Atom\\Octane\\Tests\\": "tests/"
        }
    },
    "extra": {
        "atom": {
            "providers": [
                "Eyika\\Atom\\Octane\\OctaneServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
